{
    "appId": "com.nericx.nericx",
    "productName": "Nericx",
    "copyright": "Copyright © 2026 Yukiookii",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
        "dist-electron",
        "dist-vue",
        "!node_modules/sqlite3/deps/**",
        "!node_modules/sqlite3/src/**",
        "!node_modules/sqlite3/node_modules/**",
        "!node_modules/sqlite3/binding.gyp",
        "!node_modules/sqlite3/build/Release/obj/**",
        "!node_modules/sqlite3/build/Release/*.iobj",
        "!node_modules/sqlite3/build/Release/*.ipdb",
        "!node_modules/sqlite3/build/Release/*.pdb",
        "!node_modules/sqlite3/build/Release/*.lib",
        "!node_modules/sqlite3/build/Release/*.exp",
        "!node_modules/sqlite3/build/deps/**",
        "!node_modules/sqlite3/build/*.vcxproj*",
        "!node_modules/register-scheme/**"
    ],
    "electronLanguages": ["en-US", "vi", "ja"],
    "asarUnpack": ["dist-electron/preload.cjs"],
    "extraResources": [
        {
            "from": "resources/ffmpeg",
            "to": "ffmpeg",
            "filter": ["**/ffmpeg", "**/ffmpeg.exe"]
        },
        {
            "from": "resources/licenses",
            "to": "licenses"
        }
    ],
    "icon": "./icon.ico",
    "directories": {
        "output": "dist"
    },
    "mac": {
        "target": "dmg"
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility"
    },
    "win": {
        "target": ["msi"],
        "legalTrademarks": "Nericx",
        "signingHashAlgorithms": ["sha256"],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    }
}
